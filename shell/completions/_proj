#compdef proj

_proj_project_names() {
  local -a projects
  projects=(${(f)"$(_proj_cli _complete projects 2>/dev/null)"})
  (( ${#projects} )) && _describe 'project environment' projects
}

_proj_use_names() {
  local -a names
  names=(${(f)"$(_proj_cli _complete uses 2>/dev/null)"})
  (( ${#names} )) && _describe 'module you can use' names
}

_proj_used_names() {
  local -a names
  names=(${(f)"$(_proj_cli _complete used 2>/dev/null)"})
  (( ${#names} )) && _describe 'module this environment uses' names
}

_proj_python_environments() {
  local -a environments
  environments=(${(f)"$(_proj_cli python-env list 2>/dev/null)"})
  (( ${#environments} )) &&
    _describe 'Python environment' environments
}

_proj_available_modules() {
  setopt local_options extended_glob
  local line
  local -a lmod_modules=()
  for line in ${(f)"$(module --terse avail 2>&1)"}; do
    line=${line##[[:space:]]#}
    line=${line%%[[:space:]]#}
    [[ -z $line || $line == *: || $line == */ || $line == project/* ]] && continue
    line=${line%%[[:space:]]##\(*}
    lmod_modules+=("$line")
  done
  (( ${#lmod_modules} )) &&
    _describe 'available Lmod module' lmod_modules
}

_proj_configured_modules() {
  local category=$1
  local -a configured
  configured=(${(f)"$(_proj_cli module list "$category" 2>/dev/null)"})
  (( ${#configured} )) && _describe 'configured Lmod module' configured
}

local -a commands module_actions module_categories env_actions python_actions
commands=(
  'create:Register a project environment'
  'list:List registered projects'
  'activate:Activate a project environment'
  'deactivate:Deactivate the current project'
  'share:Move a private environment to the shared registry'
  'unshare:Move a shared environment you created back to private'
  'access:Show or change who can see and change a shared environment'
  'remove:Delete a project environment'
  'use:Use a library, suite, or tool in an environment'
  'unuse:Stop using a module in an environment'
  'upgrade:Reinstall proj from its source repository'
  'current:Print the active project name'
  'status:Show active project state'
  'avail:List the modules Lmod can load, by category'
  'info:Show project environment metadata'
  'config:Read or write project metadata'
  'configmenu:Edit an environment in an interactive menu'
  'set-python-env:Link a conda-family Python environment'
  'python-env:Inspect Python environments'
  'module:Manage Lmod dependencies'
  'env:Inspect generated environments'
  'doctor:Check dependencies and integration'
  'init:Add proj to a shell startup file'
  'install:Expose the command and documentation'
  '--version:Print the installed proj version'
)
module_actions=(
  'list:List configured modules'
  'add:Add a module dependency'
  'remove:Remove a module dependency'
)
module_categories=(
  'project:Project environment modules'
  'toolchain:Build and language toolchains'
  'application:Runtime applications'
  'compiler:Compiler modules'
)
env_actions=(
  'list:List generated environments'
  'show:Show an effective environment'
)
python_actions=(
  'list:List Python environments'
  'stamp:Record the dependency file an environment was built from'
)

# Direct positional dispatch is intentionally used instead of a nested
# _arguments state machine. It mirrors argparse exactly and remains predictable
# for commands with several positional choices.
if (( CURRENT == 2 )); then
  # The everyday commands win a shared prefix, so "proj a<Tab>" and
  # "proj ac<Tab>" complete activate even though avail and access also start
  # that way. They stay reachable by typing one more letter, and an empty
  # prefix lists everything. Keep this list identical to proj.bash.
  local -a everyday=(activate deactivate list status current use unuse create info)
  local -a preferred=()
  local entry
  if [[ -n $PREFIX ]]; then
    for entry in $commands; do
      (( ${everyday[(Ie)${entry%%:*}]} )) && [[ ${entry%%:*} == ${PREFIX}* ]] &&
        preferred+=("$entry")
    done
  fi
  (( ${#preferred} )) && commands=("${preferred[@]}")
  _describe 'proj command' commands
  return
fi

if [[ ${words[CURRENT-1]-} == --env || ${words[CURRENT-1]-} == --project ]]; then
  _proj_project_names
  return
fi
if [[ ${words[CURRENT-1]-} == --manager ]]; then
  _values 'Python environment manager' micromamba conda mamba
  return
fi

case $words[2] in
  activate)
    (( CURRENT == 3 )) && _proj_project_names
    ;;
  upgrade)
    _values 'option' --check --yes --force --ref
    ;;
  share)
    if (( CURRENT == 3 )); then
      _proj_project_names
    else
      _values 'option' --group --group-writable --private
    fi
    ;;
  access)
    if (( CURRENT == 3 )); then
      _proj_project_names
    else
      _values 'option' --owner-only --group-writable --private
    fi
    ;;
  unshare)
    if (( CURRENT == 3 )); then
      _proj_project_names
    else
      _values 'option' --force
    fi
    ;;
  remove)
    if (( CURRENT == 3 )); then
      _proj_project_names
    else
      _values 'option' --yes --delete-files --keep-files
    fi
    ;;
  create)
    if [[ ${words[CURRENT-1]-} == --root ]]; then
      _directories
    elif [[ ${words[CURRENT-1]-} == --use ]]; then
      _proj_use_names
    elif [[ ${words[CURRENT-1]-} == --from ]]; then
      _proj_project_names
    elif [[ ${words[CURRENT-1]-} == --python ]]; then
      _proj_python_environments
    elif (( CURRENT >= 4 )); then
      _values 'option' --root --from --python --shared --group --group-writable --private --use
    fi
    ;;
  use)
    if [[ $PREFIX == -* ]]; then
      _values 'option' --env --list
    else
      _proj_use_names
    fi
    ;;
  unuse)
    if [[ $PREFIX == -* ]]; then
      _values 'option' --env
    else
      _proj_used_names
    fi
    ;;
  init)
    case ${words[CURRENT-1]-} in
      --shell) _values 'shell' zsh bash ;;
      --rc) _files ;;
      *) _values 'option' --shell --rc --reverse ;;
    esac
    ;;
  config)
    if (( CURRENT == 3 )); then
      _values 'configuration key' \
        project.description project.root project.shell \
        python.manager python.environment python.spec paths.prepend \
        hooks.startup hooks.shutdown
    fi
    ;;
  avail)
    _values 'category or option' compiler toolchain application project --json
    ;;
  info)
    if (( CURRENT == 3 )); then
      _values 'option' --env
    fi
    ;;
  configmenu)
    _values 'option' --env --setup
    ;;
  set-python-env)
    if (( CURRENT == 3 )); then
      _proj_python_environments
    else
      _values 'option' --env --manager
    fi
    ;;
  python-env)
    if (( CURRENT == 3 )); then
      _describe 'Python environment action' python_actions
    elif [[ $words[3] == stamp ]]; then
      _values 'option' --env
    else
      _values 'option' --manager
    fi
    ;;
  module)
    if (( CURRENT == 3 )); then
      _describe 'module action' module_actions
    elif (( CURRENT == 4 )); then
      _describe 'module category' module_categories
    elif (( CURRENT == 5 )); then
      case $words[3] in
        add) _proj_available_modules ;;
        remove) _proj_configured_modules "$words[4]" ;;
      esac
    fi
    ;;
  env)
    if (( CURRENT == 3 )); then
      _describe 'environment action' env_actions
    elif [[ $words[3] == show && CURRENT == 4 ]]; then
      _proj_project_names
    fi
    ;;
esac
